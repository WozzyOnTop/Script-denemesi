    for _, pet in ipairs(unique) do
        if pet.Name == "Titanium Hydra" then
            table.insert(fr.hydras, pet)
        elseif pet.Name == "Tribal Overlord" then
            table.insert(fr.tribals, pet)
        end
    end
    fr.equippedCount = 0
    for _, pet in ipairs(fr.hydras) do
        if fr.equippedCount >= fr.maxSlots then break end
        services.replicatedstorage.rEvents.equipPetEvent:FireServer("equipPet", pet)
        fr.equippedCount += 1
    end
    for _, pet in ipairs(fr.tribals) do
        if fr.equippedCount >= fr.maxSlots then break end
        services.replicatedstorage.rEvents.equipPetEvent:FireServer("equipPet", pet)
        fr.equippedCount += 1
    end
end

fr.performRebirth = function()
    fr.strengthTarget = 5000 + fr.rebirths.Value * 2550
    fr.repsPerBurst = lp.player.MembershipType == Enum.MembershipType.Premium and 6 or 12
    while fr.running and fr.strength.Value < fr.strengthTarget do
        for i = 1, fr.repsPerBurst do
            if not fr.running then break end
            services.muscleEvent:FireServer("rep")
        end
        task.wait(0.01)
    end
    if fr.running and fr.strength.Value >= fr.strengthTarget then
        fr.equipRebirthPets()
        task.wait(0.01)
        fr.rebirthValueBefore = fr.rebirths.Value
        repeat
            services.replicatedstorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest")
            task.wait(0.01)
        until fr.rebirths.Value > fr.rebirthValueBefore or not fr.running
    end
end

fr.startWorker = function()
    if fr.workerActive then return end
    fr.workerActive = true
    task.spawn(function()
        while fr.running do
            fr.equipFarmingPets()
            fr.performRebirth()
            task.wait(0.01)
        end
        fr.workerActive = false
    end)
end

