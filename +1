function Kryvex.CreateWatermark()
    local parent = LP:FindFirstChildOfClass("PlayerGui") or game:GetService("CoreGui")
    local old = parent:FindFirstChild("KryvexWatermark")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "KryvexWatermark"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 99999
    gui.Parent = parent

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 260, 0, 56)
    frame.Position = UDim2.new(0, 20, 0, 20)
    frame.BackgroundColor3 = BG_BLACK
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Parent = gui

    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
    
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = RED
    stroke.Thickness = 2
    stroke.Transparency = 0.15

    -- KX Logo
    local kxBox = Instance.new("Frame", frame)
    kxBox.Size = UDim2.new(0, 42, 0, 42)
    kxBox.Position = UDim2.new(0, 8, 0.5, 0)
    kxBox.AnchorPoint = Vector2.new(0, 0.5)
    kxBox.BackgroundColor3 = DARK_RED
    kxBox.BorderSizePixel = 0
    Instance.new("UICorner", kxBox).CornerRadius = UDim.new(1, 0)

    local kxGrad = Instance.new("UIGradient", kxBox)
    kxGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, LIGHT_RED),
        ColorSequenceKeypoint.new(1, DARK_RED)
    })
    kxGrad.Rotation = 45

    local kxLabel = Instance.new("TextLabel", kxBox)
    kxLabel.Size = UDim2.new(1, 0, 1, 0)
    kxLabel.BackgroundTransparency = 1
    kxLabel.Text = "KX"
    kxLabel.Font = Enum.Font.GothamBlack
    kxLabel.TextSize = 20
    kxLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    kxLabel.TextStrokeTransparency = 0.3
    kxLabel.TextStrokeColor3 = Color3.fromRGB(60, 0, 0)

    local title = Instance.new("TextLabel", frame)
    title.Size = UDim2.new(1, -58, 0, 24)
    title.Position = UDim2.new(0, 56, 0, 6)
    title.BackgroundTransparency = 1
    title.Text = "KRYVEX HUB"
    title.TextColor3 = Color3.fromRGB(255, 50, 50)
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 16
    title.TextXAlignment = Enum.TextXAlignment.Left

    local info = Instance.new("TextLabel", frame)
    info.Size = UDim2.new(1, -58, 0, 18)
    info.Position = UDim2.new(0, 56, 0, 30)
    info.BackgroundTransparency = 1
    info.Text = "Monkey Escape"
    info.TextColor3 = TEXT_SUB
    info.Font = Enum.Font.Code
    info.TextSize = 11
    info.TextXAlignment = Enum.TextXAlignment.Left

    local frames, fpsTick = 0, tick()
    RunService.RenderStepped:Connect(function()
        frames = frames + 1
        if tick() - fpsTick >= 1 then
            local ping = 0
            pcall(function()
                ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            info.Text = string.format("Monkey Escape | FPS: %d | Ping: %dms", frames, ping)
            frames, fpsTick = 0, tick()
        end
    end)

    -- Drag
    local drag, ds, sp
    frame.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag, ds, sp = true, i.Position, frame.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then drag = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - ds
            frame.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
        end
    end)

    return gui
end

