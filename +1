    local dragging, dragStart, startPos
    topBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = i.Position
            startPos = main.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local delta = i.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- API
    local tabs = {}
    local api = {}

    function api.AddTab(name)
        local tabBtn = Instance.new("TextButton", tabBar)
        tabBtn.Size = UDim2.new(1, -10, 0, 34)
        tabBtn.BackgroundColor3 = BG_CARD
        tabBtn.BackgroundTransparency = 0.5
        tabBtn.BorderSizePixel = 0
        tabBtn.Text = name
        tabBtn.TextColor3 = TEXT_SUB
        tabBtn.Font = Enum.Font.GothamBold
        tabBtn.TextSize = 13
        tabBtn.LayoutOrder = #tabs + 1
        Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

        local tabContent = Instance.new("Frame", scroll)
        tabContent.Size = UDim2.new(1, 0, 0, 0)
        tabContent.AutomaticSize = Enum.AutomaticSize.Y
        tabContent.BackgroundTransparency = 1
        tabContent.Visible = false
        tabContent.LayoutOrder = #tabs + 1

        local tabContentLayout = Instance.new("UIListLayout", tabContent)
        tabContentLayout.Padding = UDim.new(0, 7)
        tabContentLayout.SortOrder = Enum.SortOrder.LayoutOrder

        tabBtn.MouseButton1Click:Connect(function()
            for _, t in pairs(tabs) do
                t.btn.BackgroundTransparency = 0.5
                t.btn.BackgroundColor3 = BG_CARD
                t.btn.TextColor3 = TEXT_SUB
                t.content.Visible = false
            end
            tabBtn.BackgroundTransparency = 0.2
            tabBtn.BackgroundColor3 = RED
            tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tabContent.Visible = true
        end)
        
        tabBtn.MouseEnter:Connect(function()
            if tabBtn.BackgroundTransparency > 0.3 then
                tabBtn.BackgroundColor3 = BG_CARD_HOVER
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if tabBtn.BackgroundTransparency > 0.3 then
                tabBtn.BackgroundColor3 = BG_CARD
            end
        end)

        local tabData = {btn = tabBtn, content = tabContent}
        table.insert(tabs, tabData)

        if #tabs == 1 then
            tabBtn.BackgroundTransparency = 0.2
            tabBtn.BackgroundColor3 = RED
            tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tabContent.Visible = true
        end

        local tabApi = {}
        local order = 0

        function tabApi.AddSection(text)
            order = order + 1
            local sec = Instance.new("Frame", tabContent)
            sec.Size = UDim2.new(1, -10, 0, 28)
            sec.BackgroundColor3 = DARK_RED
            sec.BackgroundTransparency = 0.5
            sec.BorderSizePixel = 0
            sec.LayoutOrder = order
            Instance.new("UICorner", sec).CornerRadius = UDim.new(0, 6)

            local secLbl = Instance.new("TextLabel", sec)
            secLbl.Size = UDim2.new(1, -20, 1, 0)
            secLbl.Position = UDim2.new(0, 12, 0, 0)
            secLbl.BackgroundTransparency = 1
            secLbl.Text = "■  " .. text
            secLbl.TextColor3 = LIGHT_RED
            secLbl.Font = Enum.Font.GothamBold
            secLbl.TextSize = 13
            secLbl.TextXAlignment = Enum.TextXAlignment.Left
            return sec
        end

        function tabApi.AddButton(text, callback)
            order = order + 1
            local btn = Instance.new("TextButton", tabContent)
            btn.Size = UDim2.new(1, -10, 0, 34)
            btn.BackgroundColor3 = BG_CARD
            btn.BackgroundTransparency = 0.2
            btn.BorderSizePixel = 0
            btn.Text = text
            btn.TextColor3 = TEXT_WHITE
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 13
            btn.LayoutOrder = order
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

            local s = Instance.new("UIStroke", btn)
            s.Color = RED
            s.Thickness = 1
            s.Transparency = 0.6

            btn.MouseButton1Click:Connect(function() callback() end)
            btn.MouseEnter:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = DARK_RED, BackgroundTransparency = 0.3}):Play()
            end)
            btn.MouseLeave:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = BG_CARD, BackgroundTransparency = 0.2}):Play()
            end)
            return btn
        end

        function tabApi.AddToggle(text, default, callback)
            order = order + 1
            local state = default
            local toggle = Instance.new("TextButton", tabContent)
            toggle.Size = UDim2.new(1, -10, 0, 34)
            toggle.BackgroundColor3 = BG_CARD
            toggle.BackgroundTransparency = 0.2
            toggle.BorderSizePixel = 0
            toggle.Text = ""
            toggle.LayoutOrder = order
            Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 6)

            local s = Instance.new("UIStroke", toggle)
            s.Color = RED
            s.Thickness = 1
            s.Transparency = 0.6

            local lbl = Instance.new("TextLabel", toggle)
            lbl.Size = UDim2.new(0.72, 0, 1, 0)
            lbl.Position = UDim2.new(0, 12, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = TEXT_WHITE
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.TextXAlignment = Enum.TextXAlignment.Left

            local circle = Instance.new("Frame", toggle)
            circle.Size = UDim2.new(0, 22, 0, 22)
            circle.Position = UDim2.new(1, -30, 0.5, 0)
            circle.AnchorPoint = Vector2.new(0, 0.5)
            circle.BorderSizePixel = 0
            Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

            local function update()
                if state then
                    TweenService:Create(circle, TweenInfo.new(0.2), {BackgroundColor3 = RED}):Play()
                    TweenService:Create(toggle, TweenInfo.new(0.2), {BackgroundColor3 = DARK_RED}):Play()
                else
                    TweenService:Create(circle, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 20, 20)}):Play()
                    TweenService:Create(toggle, TweenInfo.new(0.2), {BackgroundColor3 = BG_CARD}):Play()
                end
            end
            update()

            toggle.MouseButton1Click:Connect(function()
                state = not state
                update()
                callback(state)
            end)
            return toggle
        end

        function tabApi.AddSlider(text, min, max, default, callback)
            order = order + 1
            local slider = Instance.new("Frame", tabContent)
            slider.Size = UDim2.new(1, -10, 0, 50)
            slider.BackgroundColor3 = BG_CARD
            slider.BackgroundTransparency = 0.2
            slider.BorderSizePixel = 0
            slider.LayoutOrder = order
            Instance.new("UICorner", slider).CornerRadius = UDim.new(0, 6)

            local s = Instance.new("UIStroke", slider)
            s.Color = RED
            s.Thickness = 1
            s.Transparency = 0.6

            local lbl = Instance.new("TextLabel", slider)
            lbl.Size = UDim2.new(0.7, 0, 0, 22)
            lbl.Position = UDim2.new(0, 12, 0, 4)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = TEXT_WHITE
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.TextXAlignment = Enum.TextXAlignment.Left

            local val = Instance.new("TextLabel", slider)
            val.Size = UDim2.new(0.25, 0, 0, 22)
            val.Position = UDim2.new(0.72, 0, 0, 4)
            val.BackgroundTransparency = 1
            val.Text = tostring(default)
            val.TextColor3 = RED
            val.Font = Enum.Font.GothamBold
            val.TextSize = 13
            val.TextXAlignment = Enum.TextXAlignment.Right

            local bar = Instance.new("Frame", slider)
            bar.Size = UDim2.new(1, -24, 0, 6)
            bar.Position = UDim2.new(0, 12, 0, 32)
            bar.BackgroundColor3 = Color3.fromRGB(50, 15, 15)
            bar.BorderSizePixel = 0
            Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

            local fill = Instance.new("Frame", bar)
            fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            fill.BackgroundColor3 = RED
            fill.BorderSizePixel = 0
            Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

            local dragging, startX, startVal
            bar.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    startX = i.Position
                    startVal = fill.Size.X.Scale
                    i.Changed:Connect(function()
                        if i.UserInputState == Enum.UserInputState.End then dragging = false end
                    end)
                end
            end)
            UIS.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                    local delta = (i.Position.X - startX.X) / bar.AbsoluteSize.X
                    local newScale = math.clamp(startVal + delta, 0, 1)
                    fill.Size = UDim2.new(newScale, 0, 1, 0)
                    local v = math.floor(min + (max - min) * newScale)
                    val.Text = tostring(v)
                    callback(v)
                end
            end)
            return slider
        end

        function tabApi.AddDropdown(text, options, callback)
            order = order + 1
            local dd = Instance.new("Frame", tabContent)
            dd.Size = UDim2.new(1, -10, 0, 34)
            dd.BackgroundColor3 = BG_CARD
            dd.BackgroundTransparency = 0.2
            dd.BorderSizePixel = 0
            dd.LayoutOrder = order
            dd.ClipsDescendants = false
            Instance.new("UICorner", dd).CornerRadius = UDim.new(0, 6)

            local s = Instance.new("UIStroke", dd)
            s.Color = RED
            s.Thickness = 1
            s.Transparency = 0.6

            local ddBtn = Instance.new("TextButton", dd)
            ddBtn.Size = UDim2.new(1, 0, 1, 0)
            ddBtn.BackgroundTransparency = 1
            ddBtn.Text = text .. "  ▼"
            ddBtn.TextColor3 = TEXT_WHITE
            ddBtn.Font = Enum.Font.Gotham
            ddBtn.TextSize = 13

            local list = Instance.new("ScrollingFrame", dd)
            list.Size = UDim2.new(1, 0, 0, 0)
            list.Position = UDim2.new(0, 0, 1, 2)
            list.BackgroundColor3 = BG_BLACK
            list.BorderSizePixel = 0
            list.ScrollBarThickness = 3
            list.ScrollBarImageColor3 = RED
            list.Visible = false
            list.AutomaticCanvasSize = Enum.AutomaticSize.Y
            list.CanvasSize = UDim2.new(0, 0, 0, 0)
            list.ZIndex = 10
            Instance.new("UICorner", list).CornerRadius = UDim.new(0, 6)

            local listStroke = Instance.new("UIStroke", list)
            listStroke.Color = RED
            listStroke.Thickness = 1
            listStroke.Transparency = 0.5

            local layout = Instance.new("UIListLayout", list)
            layout.Padding = UDim.new(0, 3)

            local padding = Instance.new("UIPadding", list)
            padding.PaddingTop = UDim.new(0, 4)
            padding.PaddingLeft = UDim.new(0, 4)
            padding.PaddingRight = UDim.new(0, 4)

            local isOpen = false
            for _, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton", list)
                optBtn.Size = UDim2.new(1, -8, 0, 28)
                optBtn.BackgroundColor3 = BG_CARD
                optBtn.BackgroundTransparency = 0.4
                optBtn.BorderSizePixel = 0
                optBtn.Text = opt
                optBtn.TextColor3 = TEXT_WHITE
                optBtn.Font = Enum.Font.Gotham
                optBtn.TextSize = 12
                Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 4)
                optBtn.MouseButton1Click:Connect(function()
                    ddBtn.Text = opt .. "  ▼"
                    list.Visible = false
                    isOpen = false
                    callback(opt)
                end)
                optBtn.MouseEnter:Connect(function()
                    optBtn.BackgroundColor3 = DARK_RED
                end)
                optBtn.MouseLeave:Connect(function()
                    optBtn.BackgroundColor3 = BG_CARD
                end)
            end
            
            list.Size = UDim2.new(1, 0, 0, math.min(#options * 31 + 8, 180))

            ddBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                list.Visible = isOpen
            end)
            return dd
        end

        function tabApi.AddInput(text, placeholder, callback)
            order = order + 1
            local inp = Instance.new("Frame", tabContent)
            inp.Size = UDim2.new(1, -10, 0, 34)
            inp.BackgroundColor3 = BG_CARD
            inp.BackgroundTransparency = 0.2
            inp.BorderSizePixel = 0
            inp.LayoutOrder = order
            Instance.new("UICorner", inp).CornerRadius = UDim.new(0, 6)

            local s = Instance.new("UIStroke", inp)
            s.Color = RED
            s.Thickness = 1
            s.Transparency = 0.6

            local box = Instance.new("TextBox", inp)
            box.Size = UDim2.new(1, -20, 1, 0)
            box.Position = UDim2.new(0, 10, 0, 0)
            box.BackgroundTransparency = 1
            box.Text = ""
            box.PlaceholderText = text .. " (" .. placeholder .. ")"
            box.PlaceholderColor3 = TEXT_SUB
            box.TextColor3 = TEXT_WHITE
            box.Font = Enum.Font.Gotham
            box.TextSize = 13
            box.TextXAlignment = Enum.TextXAlignment.Left
            box.ClearTextOnFocus = false

            box.FocusLost:Connect(function() callback(box.Text) end)
            return inp
        end

        function tabApi.AddLabel(text)
            order = order + 1
            local lbl = Instance.new("TextLabel", tabContent)
            lbl.Size = UDim2.new(1, -10, 0, 22)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = TEXT_SUB
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.LayoutOrder = order
            return lbl
        end

        return tabApi
    end

    return api, gui
end

