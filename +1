            services.replicatedstorage.rEvents.equipPetEvent:FireServer("equipPet", fr.swifts[i])
            fr.currentPercent += 15
            fr.equippedCount += 1
        end
    end
    if fr.currentPercent >= 100 then
        for i = #fr.hounds, 1, -1 do
