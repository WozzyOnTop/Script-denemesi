tabFarming:AddTextBox("⚡ Rep Speed (Default: 200)", function(value)
    local speed = tonumber(value)
    if speed then
        speed = math.clamp(math.floor(speed), 1, fs.maxSendRate)
        fs.repSpeed = speed
        if fs.running then
            fs.sendRate = speed
            fs.sendTokens = 0
            fs.Status.Text = "Status: Farming | " .. formatNumber(speed) .. " reps/s"
        end
    end
end)

fs.updateRuntime = function()
    local elapsed = fs.totalElapsed
    if fs.running and fs.timerStarted then
        elapsed = elapsed + tick() - fs.startedAt
    end
    fs.Runtime.Text = string.format("Runtime: %dd %dh %dm %ds",
        math.floor(elapsed / 86400),
        math.floor((elapsed % 86400) / 3600),
        math.floor((elapsed % 3600) / 60),
        math.floor(elapsed % 60))
end

fs.updateStats = function()
    fs.StrengthStats.Text = "Strength: " .. formatNumber(fs.strength.Value) .. " | Gained: " .. formatNumber(fs.strength.Value - fs.startStrength)
    fs.DurabilityStats.Text = "Durability: " .. formatNumber(fs.durability.Value) .. " | Gained: " .. formatNumber(fs.durability.Value - fs.startDurability)
end

fs.workerLoop = function()
    fs.lastLoopAt = os.clock()
    while fs.running do
        local now = os.clock()
        local elapsed = math.min(0.01, now - fs.lastLoopAt)
        fs.lastLoopAt = now
        fs.sendRate = fs.repSpeed
        fs.sendTokens = math.min(fs.maxBurst, fs.sendTokens + fs.sendRate * elapsed)
        local burstLimit = math.max(1, math.min(fs.maxBurst, math.ceil(fs.sendRate * 0.01)))
        local sendCount = math.min(math.floor(fs.sendTokens), burstLimit)
        for i = 1, sendCount do
            if not fs.running then break end
            services.muscleEvent:FireServer("rep")
        end
        fs.sendTokens = fs.sendTokens - sendCount
        services.runservice.Heartbeat:Wait()
    end
    fs.workerActive = false
end

fs.startWorker = function()
    if fs.workerActive then return end
    fs.workerActive = true
    task.spawn(fs.workerLoop)
end

fs.strength:GetPropertyChangedSignal("Value"):Connect(function() fs.updateStats() end)
fs.durability:GetPropertyChangedSignal("Value"):Connect(function() fs.updateStats() end)

