    t.BackgroundTransparency = 1
    t.Text = title or "Kryvex"
    t.TextColor3 = Color3.fromRGB(255, 80, 80)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 14
    t.TextXAlignment = Enum.TextXAlignment.Left

    local c = Instance.new("TextLabel", frame)
    c.Size = UDim2.new(1, -20, 0, 30)
    c.Position = UDim2.new(0, 14, 0, 28)
    c.BackgroundTransparency = 1
    c.Text = content or ""
    c.TextColor3 = TEXT_WHITE
    c.Font = Enum.Font.Gotham
    c.TextSize = 12
    c.TextXAlignment = Enum.TextXAlignment.Left
    c.TextWrapped = true

    local bar = Instance.new("Frame", frame)
    bar.Size = UDim2.new(1, -20, 0, 3)
    bar.Position = UDim2.new(0, 10, 1, -6)
    bar.BackgroundColor3 = RED
    bar.BorderSizePixel = 0
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    TweenService:Create(frame, TweenInfo.new(0.3), {Position = UDim2.new(0, 0, 0, 0)}):Play()
    TweenService:Create(bar, TweenInfo.new(duration or 3, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 3)}):Play()

    task.delay(duration or 3, function()
        TweenService:Create(frame, TweenInfo.new(0.3), {Position = UDim2.new(1, 0, 0, 0)}):Play()
        task.wait(0.35)
        frame:Destroy()
    end)
end

