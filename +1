    fr.equippedCount = 0
    fr.currentPercent = 0
    for i = #fr.omegas, 1, -1 do
        if fr.equippedCount < fr.maxSlots and fr.currentPercent < 100 then
            services.replicatedstorage.rEvents.equipPetEvent:FireServer("equipPet", fr.omegas[i])
            fr.currentPercent += 20
            fr.equippedCount += 1
