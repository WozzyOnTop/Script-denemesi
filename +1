    if v then
        task.spawn(function()
            while State.AutoTrain do
                pcall(function()
                    local char = LP.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 0, -1)
                    end
                end)
                task.wait(0.05)
            end
        end)
    end
end)

FarmTab.AddSection("Auto Win")

FarmTab.AddToggle("Auto Win (Smooth Travel)", false, function(v)
    State.AutoWin = v
    if v then
        task.spawn(function()
            while State.AutoWin do
                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp and State.WinPos then
                    if (hrp.Position - State.WinPos).Magnitude > 5 then
                        State.Fly = true
                        startFly()
                        local oldNoclip = State.Noclip
                        State.Noclip = true
                        Kryvex.Notify("Kryvex | Auto Win", "Rising up...", 2)
                        local startCF = hrp.CFrame
                        local upCF = startCF * CFrame.new(0, State.WinHeight, 0)
                        for i = 0, 1, 0.05 do
                            if not State.AutoWin or not hrp.Parent then break end
                            hrp.CFrame = startCF:Lerp(upCF, i)
                            task.wait(0.02)
                        end
                        if not State.AutoWin or not hrp.Parent then State.Noclip = oldNoclip return end
                        task.wait(0.2)
                        Kryvex.Notify("Kryvex | Auto Win", "Traveling...", 2)
                        local c1 = hrp.CFrame
                        local target = Vector3.new(State.WinPos.X, hrp.Position.Y, State.WinPos.Z)
                        local c2 = CFrame.new(target)
                        local steps = math.max(1, math.floor((hrp.Position - target).Magnitude / (State.WinSpeed / 30)))
                        for j = 1, steps do
                            if not State.AutoWin or not hrp.Parent then break end
                            hrp.CFrame = c1:Lerp(c2, j / steps)
                            task.wait(0.03)
                        end
                        if not State.AutoWin or not hrp.Parent then State.Noclip = oldNoclip return end
                        task.wait(0.2)
                        Kryvex.Notify("Kryvex | Auto Win", "Descending...", 2)
                        local c3 = hrp.CFrame
                        local c4 = CFrame.new(State.WinPos)
                        for k = 0, 1, 0.01 do
                            if not State.AutoWin or not hrp.Parent then break end
                            hrp.CFrame = c3:Lerp(c4, k)
                            task.wait(0.01)
                        end
                        if hrp.Parent then hrp.CFrame = c4 end
                        State.Noclip = oldNoclip
                        stopFly()
                        Kryvex.Notify("Kryvex | Auto Win", "Arrived! Resetting in 3s...", 3)
                        task.wait(3)
                        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                        if hum then hum.Health = 0 end
                        Kryvex.Notify("Kryvex | Auto Win", "Next loop in 5s...", 5)
                        task.wait(5)
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end)

