    Callback = function(v)
        _G.KryvexAutoStartRaid = v
        if v then
            task.spawn(function()
                while _G.KryvexAutoStartRaid do
                    pcall(function()
                        local timer = LP.PlayerGui.Main.Timer
                        if not timer.Visible then
                            if World2 then
                                CommF:InvokeServer("SetSpawnPoint")
                                fireclickdetector(game:GetService("Workspace").Map.CircleIsland.RaidSummon2.Button.Main.ClickDetector)
                            elseif World3 then
                                CommF:InvokeServer("requestEntrance", Vector3.new(-5075.5, 314.5, -3150.0))
                                task.wait(1)
                                fireclickdetector(game:GetService("Workspace").Map["Boat Castle"].RaidSummon2.Button.Main.ClickDetector)
                            end
                        end
                    end)
                    task.wait(2)
                end
            end)
        end
    end,
})

RaidTab:Toggle({
    Title = "Auto Farm Raid",
    Desc = "Kill all enemies in raid",
    Value = false,
    Callback = function(v)
        _G.KryvexAutoFarmRaid = v
        if v then
            task.spawn(function()
                while _G.KryvexAutoFarmRaid do
                    for _, enemy in ipairs(workspace.Enemies:GetChildren()) do
                        if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                            if hrp and (enemy.HumanoidRootPart.Position - hrp.Position).Magnitude < 1000 then
                                repeat
                                    EquipWeapon(State.SelectedWeapon)
                                    AutoHaki()
                                    TP(enemy.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                                    VirtualUser:CaptureController()
                                    VirtualUser:Button1Down(Vector2.new(1280, 720))
                                    task.wait(0.1)
                                until not _G.KryvexAutoFarmRaid or not enemy.Parent or enemy.Humanoid.Health <= 0
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end
    end,
})

