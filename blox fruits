local function EquipWeapon(name)
    if not name then return end
    local ch = LP.Character
    if not ch then return end
    local backpack = LP:FindFirstChild("Backpack")
    local tool = ch:FindFirstChild(name) or (backpack and backpack:FindFirstChild(name))
    if tool then
        pcall(function()
            ch:FindFirstChildOfClass("Humanoid"):EquipTool(tool)
        end)
    end
end

local function AutoHaki()
    if State.AutoHaki then
        local ch = LP.Character
        if ch and not ch:FindFirstChild("HasBuso") then
            pcall(function()
                CommF:InvokeServer("Buso")
            end)
        end
    end
end

local function GetWeaponByType(wType)
    local backpack = LP:FindFirstChild("Backpack")
    if not backpack then return nil end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if tool.ToolTip == wType then return tool.Name end
        end
    end
    return nil
end

