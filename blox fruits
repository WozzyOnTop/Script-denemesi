--// TP fonksiyonu
local TweenSpeed = 350
local function TP(pos)
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LP.Character.HumanoidRootPart
    local dist = (pos.Position - hrp.Position).Magnitude
    if dist < 5 then return end
    
    if not LP.Character:FindFirstChild("KryvexPart") then
        local p = Instance.new("Part")
        p.Name = "KryvexPart"
        p.Size = Vector3.new(1, 1, 1)
        p.Anchored = true
        p.CanCollide = false
        p.Transparency = 1
        p.CFrame = hrp.CFrame
        p.Parent = LP.Character
        p:GetPropertyChangedSignal("CFrame"):Connect(function()
            if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                LP.Character.HumanoidRootPart.CFrame = p.CFrame
            end
        end)
    end
    
    local tween = TweenService:Create(LP.Character.KryvexPart, TweenInfo.new(dist / TweenSpeed, Enum.EasingStyle.Linear), {CFrame = pos})
    tween:Play()
    tween.Completed:Wait()
    
    if LP.Character:FindFirstChild("KryvexPart") then
        LP.Character.KryvexPart:Destroy()
    end
end

