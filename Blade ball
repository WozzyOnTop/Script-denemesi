-- Ball Trail
local function ApplyBallTrail()
    local balls = workspace:FindFirstChild("Balls")
    if not balls then return end
    for _, ball in ipairs(balls:GetChildren()) do
        if ball:IsA("BasePart") and not ball:FindFirstChild("KryvexTrail") then
            local a0 = Instance.new("Attachment")
            a0.Name = "KryvexA0"
            a0.Position = Vector3.new(0, 0.5, 0)
            a0.Parent = ball
            local a1 = Instance.new("Attachment")
            a1.Name = "KryvexA1"
            a1.Position = Vector3.new(0, -0.5, 0)
            a1.Parent = ball
            local t = Instance.new("Trail")
            t.Name = "KryvexTrail"
            t.Attachment0 = a0
            t.Attachment1 = a1
            t.Color = ColorSequence.new(State.TrailColor)
            t.Lifetime = 0.6
            t.LightEmission = 1
            t.Parent = ball
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if State.BallTrail then
            pcall(ApplyBallTrail)
        end
    end
end)

-- Auto Dodge
task.spawn(function()
    while task.wait(0.1) do
        if State.AutoDodge then
            local ch = LP.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp then
                local balls = workspace:FindFirstChild("Balls")
                if balls then
                    for _, ball in ipairs(balls:GetChildren()) do
                        if ball:IsA("BasePart") and ball:GetAttribute("target") == LP.Name then
                            local zoom = ball:FindFirstChild("zoomies")
                            if zoom then
                                local vel = zoom.VectorVelocity
                                if vel.Magnitude > 30 then
                                    local toMe = (hrp.Position - ball.Position).Unit
                                    if vel.Unit:Dot(toMe) > 0.85 and (hrp.Position - ball.Position).Magnitude < 50 then
                                        local right = workspace.CurrentCamera.CFrame.RightVector
                                        hrp.CFrame = hrp.CFrame + right * (math.random() > 0.5 and 15 or -15)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

