-- Ball Prediction
local PredDrawings = {}
task.spawn(function()
    while task.wait(0.05) do
        for _, d in ipairs(PredDrawings) do
            if d.Remove then d:Remove() end
        end
        PredDrawings = {}

        if State.BallPred then
            local balls = workspace:FindFirstChild("Balls")
            if balls then
                for _, ball in ipairs(balls:GetChildren()) do
                    if ball:IsA("BasePart") then
                        local zoom = ball:FindFirstChild("zoomies")
                        if zoom then
                            local vel = zoom.VectorVelocity
                            if vel.Magnitude > 10 then
                                local origin = ball.Position
                                local pred = origin + vel.Unit * (vel.Magnitude * 0.3)
                                local so = workspace.CurrentCamera:WorldToViewportPoint(origin)
                                local sp = workspace.CurrentCamera:WorldToViewportPoint(pred)
                                if so.Z > 0 and sp.Z > 0 then
                                    local line = Drawing.new("Line")
                                    line.From = Vector2.new(so.X, so.Y)
                                    line.To = Vector2.new(sp.X, sp.Y)
                                    line.Color = Color3.fromRGB(255, 50, 50)
                                    line.Thickness = 2
                                    line.Transparency = 0.8
                                    line.Visible = true
                                    table.insert(PredDrawings, line)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

